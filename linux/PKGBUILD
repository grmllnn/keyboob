# Maintainer: Keyboop contributors
pkgname=keyboop
pkgver=0.1.0
pkgrel=1
pkgdesc="RU/EN layout auto-switch for Wayland via Fcitx5 (no clipboard)"
arch=('x86_64')
url="https://github.com/iffuno/keyboop"
license=('MIT')
depends=('fcitx5' 'gcc-libs' 'glibc')
makedepends=('cmake' 'ninja' 'nlohmann-json' 'pkgconf')
optdepends=(
  'fcitx5-configtool: GUI for hotkeys and options'
  'fcitx5-gtk: GTK IM module / XWayland helpers'
  'fcitx5-qt: Qt IM module where text-input is missing'
)
source=()
# Built from the keyboop git checkout (linux/ subdirectory).
# Usage from repo root:
#   cd linux && makepkg -si

build() {
  cmake -B build -S "$startdir" -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DKEYBOOP_BUILD_FCITX=ON \
    -DKEYBOOP_BUILD_TESTS=ON
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$startdir/../LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
